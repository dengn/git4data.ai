{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git4data-ai",
  "compatibility_date": "2026-08-20",

  // Binds the apex domain on every deploy and creates the DNS record for it,
  // so the site is never one forgotten dashboard click away from being dark.
  "routes": [
    { "pattern": "git4data.ai", "custom_domain": true }
  ],

  // Pure static site — no Worker script, just assets served from the repo root.
  // Files listed in .assetsignore are not uploaded.
  "assets": {
    "directory": "./",

    // "auto-trailing-slash" serves /benchmark from benchmark.html,
    // which is what the canonical tags and sitemap.xml assume.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
