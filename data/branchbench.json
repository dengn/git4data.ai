{
  "meta": {
    "name": "BranchBench",
    "subtitle": "Git4Data measured on the agentic database-branching benchmark",
    "updated": "2026-08-20",
    "primarySource": {
      "label": "Git4Data: Database-Native Version Control for AI Agents — CIDR '27",
      "authors": "Hongshen Gou, Zuyu Zhang, Yuze Sun, Peng Xu, Feng Tian, Long Wang (MatrixOrigin), Jianguo Wang (Purdue)",
      "url": ""
    },
    "benchmarkSource": {
      "label": "BranchBench: An Extensible Benchmark for Agentic Database Branching (CAIS '26 / arXiv:2604.17180)",
      "url": "https://arxiv.org/abs/2604.17180"
    },
    "hardware": "Bare-metal CentOS · Intel Xeon Silver, 2.4 GHz, 64 cores · 256 GB RAM · local SSD · MatrixOne deployed on Kubernetes.",
    "setup": "BranchBench at scale factor 100 is roughly 47 million rows. Each macro workflow is driven by five concurrent agents over twenty steps, each agent forking the database and merging or discarding its branch. Collaborative runs overlap on 10% of the primary keys, resolved with ACCEPT. Microbenchmarks use the TPC-H lineitem table at scale factor 100 (100 GB).",
    "disclaimer": "Every value on this page is transcribed from the tables of the papers named under each suite. Nothing is estimated, interpolated, or read off a chart."
  },
