  "findings": [
    {
      "headline": "0.20 s",
      "text": "Forking a 100 GB TPC-H lineitem table. The branch costs 314 KB of metadata; materialising the same table with INSERT … SELECT takes 114.6 s and 34 GB.",
      "src": "Table 1",
      "short": "Forking a 100 GB TPC-H lineitem table"
    },
    {
      "headline": "18.5×",
      "text": "Largest end-to-end speedup over DoltDB across the four BranchBench workflows (data_cleaning, warm runs). The smallest is still 8.4×.",
      "src": "Table 4",
      "short": "Fastest end-to-end speedup over DoltDB"
    },
    {
      "headline": "132×",
      "text": "Built-in DIFF against the equivalent hand-written SQL on a one-million-row change with a primary key — 3.27 s versus 431.50 s.",
      "src": "Table 2",
      "short": "DIFF against the equivalent hand-written SQL"
    },
    {
      "headline": "1,000",
      "text": "Concurrent branching agents in the simulation workflow. Git4Data finishes in 400 s at scale factor 100; DoltDB does not finish within four hours.",
      "src": "§4.2",
      "short": "Concurrently branching agents sustained"
    },
    {
      "headline": "3.2×",
      "text": "Cost growth for software_dev and data_cleaning when the data grows 10×. Branch-local work scales with the change, not the table.",
      "src": "Table 5",
      "short": "Cost growth when the data grows 10×"
    },
    {
      "headline": "13.5×",
      "text": "The exception: failure_repro rewrites the whole table, so its cost does track data size as the benchmark scales from SF100 to SF1,000.",
      "src": "Table 5",
      "short": "The workflow that does track data size"
    }
  ]
